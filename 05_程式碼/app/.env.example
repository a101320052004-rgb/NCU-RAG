# 複製這個檔案並改名為 .env，再填入下面的值。.env 有金鑰，不要上傳到 GitHub 或傳給別人。

# --- 選一個 LLM：LLM_PROVIDER 填 claude 或 openai_compat
LLM_PROVIDER=openai_compat

# 選項 A：Gemini 免費額度（aistudio.google.com → Get API key）
#   免費版的內容可能被 Google 用來改善服務，所以系統不送任何學生個資
#   模型名稱以 AI Studio 上顯示可用的 Flash 模型為準
COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
COMPAT_API_KEY=
COMPAT_MODEL=gemini-3.6-flash

# 選項 B：Claude（console.anthropic.com 申請，需先儲值；把上面 LLM_PROVIDER 改成 claude）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- LINE（LINE Developers → 你的 Provider → Messaging API channel）
# Basic settings 頁的 Channel secret
LINE_CHANNEL_SECRET=
# Messaging API 頁最下方 Channel access token (long-lived)，按 Issue 產生
LINE_CHANNEL_ACCESS_TOKEN=

# --- 轉人工時給學生的聯絡資訊（請照學生手冊填寫正確資料）
CONTACT_ZH=國際事務處 境外生事務承辦人 分機____ Email____
CONTACT_EN=Office of International Affairs, ext. ____, email ____
SECURITY_PHONE=

# --- 時效規則
STALE_MONTHS=12
CURRENT_ACADEMIC_YEAR=115

# --- 進階（一般不用改）
EMBEDDER=e5
E5_MODEL=intfloat/multilingual-e5-small
TOP_K=5
MAX_DISTANCE=0.30

# --- 雲端版（Vercel + Supabase）。4_上傳雲端.bat 會用到這三個；本機 demo 不用填
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_INGEST_SECRET=
